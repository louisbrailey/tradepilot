# Configuration names only. Never put secrets in the iPhone app or commit them.
# Export these privately in your server process; this example is not auto-loaded.
APP_ACCESS_TOKEN=
OPENAI_API_KEY=
# Choose a model available to your API account that supports Structured Outputs.
OPENAI_MODEL=
# Or pass --market-env /path/to/signal-forge/.env to reuse the existing key.
MASSIVE_API_KEY=

# Official Webull SDK. Keep real credentials on the private server only.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ENV=sandbox
# Set to enabled only after validating the production integration.
WEBULL_LIVE_TRADING=disabled
TRADEPILOT_RUNTIME=/absolute/private/path/tradepilot-runtime
